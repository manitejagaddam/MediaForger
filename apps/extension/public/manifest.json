{
  "manifest_version": 3,
  "name": "MediaForge — Local Media Studio",
  "version": "1.0.0",
  "description": "Universal privacy-first local media conversion and processing directly in your browser.",
  "permissions": [
    "contextMenus",
    "downloads",
    "offscreen",
    "storage",
    "sidePanel"
  ],
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MediaForge Quick Tools",
    "default_icon": "logo.png"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}

